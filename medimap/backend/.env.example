# MediMap Backend Environment Variables

PORT=5000
NODE_ENV=production

# MongoDB Connection String (e.g., MongoDB Atlas free tier)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/medimap?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=supersecret_jwt_key_change_in_production_123456

# AI Assistance (Optional - automatic rule-based fallbacks used if missing)
GROQ_API_KEY=
GEMINI_API_KEY=

# Payments (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
